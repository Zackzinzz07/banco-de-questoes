{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_camada.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/formatar.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/tamanho.sh" }
        ]
      }
    ]
  }
}
